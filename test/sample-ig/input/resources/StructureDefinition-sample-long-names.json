{
  "resourceType": "StructureDefinition",
  "id": "sample-long-names",
  "url": "https://fhir.twiin.nl/ig/sample/StructureDefinition/sample-long-names",
  "version": "0.1.0",
  "name": "SampleLongNames",
  "title": "Sample Long Names",
  "status": "draft",
  "publisher": "Twiin",
  "description": "Test profile with long element names, long URLs, a constraint and bindings, to test the layout of the profile tables on narrow screens.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "ServiceRequest",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/ServiceRequest",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "ServiceRequest",
        "path": "ServiceRequest",
        "constraint": [
          {
            "key": "twiin-long-1",
            "severity": "error",
            "human": "If the occurrence is a timing, the patient instruction and the performer type must both be present, and the reason reference must point to a condition or an observation.",
            "expression": "occurrence.ofType(Timing).exists() implies (patientInstruction.exists() and performerType.exists() and reasonReference.all(resolve() is Condition or resolve() is Observation))",
            "source": "https://fhir.twiin.nl/ig/sample/StructureDefinition/sample-long-names"
          }
        ]
      },
      {
        "id": "ServiceRequest.identifier",
        "path": "ServiceRequest.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "ServiceRequest.identifier:anIdentifierSliceWithAVeryLongNameForNarrowScreens",
        "path": "ServiceRequest.identifier",
        "sliceName": "anIdentifierSliceWithAVeryLongNameForNarrowScreens",
        "min": 0,
        "max": "1"
      },
      {
        "id": "ServiceRequest.identifier:anIdentifierSliceWithAVeryLongNameForNarrowScreens.system",
        "path": "ServiceRequest.identifier.system",
        "min": 1,
        "patternUri": "https://fhir.twiin.nl/ig/sample/NamingSystem/a-very-long-identifier-system-for-testing-narrow-screens"
      },
      {
        "id": "ServiceRequest.performerType",
        "path": "ServiceRequest.performerType",
        "binding": {
          "strength": "extensible",
          "valueSet": "http://hl7.org/fhir/ValueSet/participant-role"
        }
      },
      {
        "id": "ServiceRequest.patientInstruction",
        "path": "ServiceRequest.patientInstruction",
        "short": "PatientInstructionsThatAreWrittenAsOneVeryLongWordWithoutSpaces"
      }
    ]
  }
}
